<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zdb.local.toolprobe</ToolCommandName>
    <PackageId>zdb.local.toolprobe</PackageId>
    <Version>999.0.0</Version>
    <Authors>ZeroDayBugs CI probe</Authors>
    <Description>Harmless generic dnx package-source precedence probe.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
